---
import Page from '../../layouts/Page.astro';
import NoteList from '../../components/NoteList.astro';
import { allNotes } from '../../lib/notes';

const notes = await allNotes();
---

<Page
	title="Notes"
	eyebrow="Notes"
	lede="Releases, decisions, letters and the occasional essay. Written when there is something to say."
	path="/notes/"
	current="notes"
>
	{notes.length > 0 ? <NoteList notes={notes} /> : <p class="lede">Nothing here yet.</p>}
	<p class="meta">Subscribe: <a href="/rss.xml">RSS</a> · <a href="/feed.json">JSON Feed</a></p>
</Page>
