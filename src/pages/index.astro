---
/**
 * The front door: the homescreen (src/components/Homescreen.astro). It is the
 * whole public site in a holding build, and the full site's home otherwise;
 * the full build adds a Notes icon to the dock.
 */
import Base from '../layouts/Base.astro';
import Homescreen from '../components/Homescreen.astro';
---

<Base path="/" header={false} footer={false} flush>
	<Homescreen />
</Base>
