---
/**
 * The front door. Which one depends on the build mode (src/config.ts):
 * `holding` is what the public sees while the writing is being done, `full` is
 * the homescreen with everything behind it.
 */
import Base from '../layouts/Base.astro';
import Holding from '../components/Holding.astro';
import Homescreen from '../components/Homescreen.astro';
import { IS_HOLDING } from '../config';
---

<Base path="/" header={false} flush>
	{IS_HOLDING ? <Holding /> : <Homescreen />}
</Base>
