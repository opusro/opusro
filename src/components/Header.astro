---
/** One-line header for every page except home: mark left, sections right. */
import Mark from './Mark.astro';
import { NAV, SITE } from '../config';

interface Props {
	current?: string;
}
const { current } = Astro.props;
---

<header class="header">
	<div class="wrap header__inner">
		<a class="header__home" href="/" aria-label={`${SITE.name}, home`}>
			<Mark size={28} />
			<span class="header__name">{SITE.name}</span>
		</a>
		<nav class="header__nav" aria-label="Sections">
			{
				NAV.map((item) => (
					<a href={item.href} aria-current={current === item.label ? 'page' : undefined}>
						{item.label}
					</a>
				))
			}
		</nav>
	</div>
</header>

<style>
	.header {
		padding-block: var(--space-m);
		border-bottom: 1px solid var(--hairline);
	}
	.header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-m);
		flex-wrap: wrap;
	}
	.header__home {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		text-decoration: none;
		color: var(--ink);
	}
	.header__name {
		font-weight: 500;
		letter-spacing: 0.18em;
		font-size: var(--step--1);
	}
	.header__nav {
		display: flex;
		gap: var(--space-m);
		font-size: var(--step--1);
	}
	.header__nav a {
		text-decoration: none;
		color: var(--ink-2);
	}
	.header__nav a:hover,
	.header__nav a[aria-current='page'] {
		color: var(--ink);
	}
</style>
