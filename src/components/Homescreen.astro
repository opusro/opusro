---
/**
 * The front door: the March 2026 homescreen, brought back and refined.
 *
 * The first screen of a phone or a Mac. The mark where the clock would be, and
 * a dock of apps at the bottom. Nothing else. Tap an app and its icon lifts
 * out of the dock into its story, the way an App Store "Today" card opens: the
 * app's mark drawn in white particles, the app's own headline, the app row with Get, a few excerpts from
 * its landing page, then Download on the App Store (or Coming soon) and Find
 * out more. A card on a desktop, a tall sheet from the bottom on a phone. The
 * words come from each tool's `story` in src/content/tools/. Black, white and
 * greys only, as the rest of the screen: the tools' own colours stay on their
 * own sites. Contact is the
 * last icon, behind a divider, as folders sit on a Mac's dock.
 *
 * The same page is the public site (holding) and the full site's home; the
 * full build adds a Notes icon. Every icon is a real link first (the app's own
 * site, the mailto, /notes/), so the page works with no script at all; with
 * /home.js the links open the sheets instead.
 */
import BrandMark from './BrandMark.astro';
import { SITE, DOORWAYS, IS_HOLDING } from '../config';
import { homeTools } from '../lib/notes';

const tools = await homeTools();
/** Icons in the dock: the tools, Notes in a full build, Contact. */
const dockCount = tools.length + (IS_HOLDING ? 0 : 1) + 1;
const year = new Date().getFullYear();

const host = (url?: string) => (url ? new URL(url).host : undefined);
const primaryHref = (t: (typeof tools)[number]['data']) => t.site ?? t.appStoreUrl ?? t.webUrl ?? '#';

const instagram = DOORWAYS.find((d) => d.label === 'Instagram');
const youtube = DOORWAYS.find((d) => d.label === 'YouTube');
---

<div class="home" data-home>
	<div class="home__grain" aria-hidden="true"></div>

	<header class="home__brand">
		<BrandMark />
	</header>

	<nav class="dock" aria-label="Apps" data-dock style={`--n:${dockCount}`}>
		<ul class="dock__tray" data-dock-tray>
			{
				tools.map((tool) => {
					const t = tool.data;
					const soon = t.status !== 'available';
					return (
						<li class="dock__item" data-dock-item>
							<a
								class:list={['app', soon && 'app--soon']}
								href={primaryHref(t)}
								data-open={tool.id}
								aria-label={soon ? `${t.name}, coming soon` : t.name}
							>
								<span class="app__icon" data-icon={tool.id}>
									{t.glyph ? (
										<img class="app__glyph" src={t.glyph} alt="" width="30" height="30" />
									) : (
										<span class="app__initial">{t.name.charAt(0).toLowerCase()}</span>
									)}
								</span>
								<span class="app__label" aria-hidden="true">
									{soon && <i class="app__dot" />}
									{t.name}
								</span>
							</a>
						</li>
					);
				})
			}
			<li class="dock__divider" aria-hidden="true"></li>
			{
				!IS_HOLDING && (
					<li class="dock__item" data-dock-item>
						<a class="app" href="/notes/" aria-label="Notes">
							<span class="app__icon" style="view-transition-name: tile-notes">
								<svg class="app__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
									<path d="M5 7h14M5 12h11M5 17h8" />
								</svg>
							</span>
							<span class="app__label" aria-hidden="true">
								Notes
							</span>
						</a>
					</li>
				)
			}
			<li class="dock__item" data-dock-item>
				<a class="app" href={`mailto:${SITE.email}`} data-open="contact" aria-label="Contact">
					<span class="app__icon" data-icon="contact">
						<span class="app__at">@</span>
					</span>
					<span class="app__label" aria-hidden="true">Contact</span>
				</a>
			</li>
		</ul>
	</nav>

	{
		tools.map((tool) => {
			const t = tool.data;
			const soon = t.status !== 'available';
			const story = t.story;
			const hero = story?.hero ?? (t.glyph ? 'mark' : 'wordmark');
			return (
				<dialog class="sheet sheet--story" id={`sheet-${tool.id}`} data-sheet={tool.id} aria-label={t.name}>
					<div class="sheet__scrim" data-scrim aria-hidden="true" />
					<div class="sheet__panel story" data-panel>
						<button class="sheet__close" type="button" data-close aria-label="Close">
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M6 6l12 12M18 6L6 18" />
							</svg>
						</button>
						<div class="story__scroll" data-scroll>
							<div class:list={['story__hero', `story__hero--${hero}`]} data-drag>
								<div class="story__art" data-art aria-hidden="true">
									<canvas
										class="story__canvas"
										data-particles={hero !== 'wordmark' ? t.glyph : undefined}
										data-text={hero === 'wordmark' || !t.glyph ? t.name : undefined}
										data-flow={hero === 'exchange' ? '' : undefined}
									/>
								</div>
								<span class="sheet__grabber" aria-hidden="true" />
								<div class="story__overlay" data-reveal>
									{story?.eyebrow && <p class="story__eyebrow">{story.eyebrow}</p>}
									<h2 class="story__headline">{story?.headline ?? t.name}</h2>
								</div>
							</div>

							<div class="story__app">
								<span class="app__icon sheet__icon" data-sheet-icon>
									{t.glyph ? (
										<img class="app__glyph" src={t.glyph} alt="" width="30" height="30" />
									) : (
										<span class="app__initial">{t.name.charAt(0).toLowerCase()}</span>
									)}
								</span>
								<div class="story__app-text" data-reveal>
									<p class="story__app-name">{t.name}</p>
									{t.subtitle && <p class="story__app-sub">{t.subtitle}</p>}
								</div>
								{soon ? (
									<span class="story__get story__get--soon" data-reveal>
										Soon
									</span>
								) : (
									t.appStoreUrl && (
										<a class="story__get" href={t.appStoreUrl} rel="noopener" data-reveal>
											Get
										</a>
									)
								)}
							</div>

							<div class="story__body">
								{story?.lede && (
									<p class="story__lede" data-reveal>
										{story.lede}
									</p>
								)}
								{!story && t.oneLine && (
									<p class="story__lede" data-reveal>
										{t.oneLine}
									</p>
								)}
								{story?.excerpts.map((e) => (
									<section class="story__excerpt" data-reveal>
										<h3>{e.title}</h3>
										<p>{e.body}</p>
									</section>
								))}
								{story?.fineprint && (
									<p class="story__fine" data-reveal>
										{story.fineprint}
									</p>
								)}
								<div class="story__actions" data-reveal>
									{!soon && t.appStoreUrl && (
										<a class="pill pill--solid" href={t.appStoreUrl} rel="noopener">
											<svg viewBox="0 0 24 24" aria-hidden="true">
												<path d="M16.37 12.6c-.02-2.2 1.8-3.26 1.88-3.31-1.03-1.5-2.62-1.7-3.18-1.73-1.35-.14-2.64.8-3.33.8-.69 0-1.74-.78-2.87-.76-1.47.02-2.83.86-3.59 2.18-1.53 2.66-.39 6.6 1.1 8.76.73 1.06 1.6 2.24 2.73 2.2 1.1-.05 1.51-.71 2.84-.71 1.32 0 1.7.71 2.86.69 1.18-.02 1.93-1.07 2.65-2.13.84-1.22 1.18-2.41 1.2-2.47-.03-.01-2.3-.88-2.32-3.5zM14.2 6.13c.6-.73 1-1.74.9-2.75-.87.04-1.92.58-2.54 1.3-.56.64-1.05 1.67-.92 2.66.97.08 1.96-.49 2.56-1.21z" fill="currentColor" />
											</svg>
											Download on the App Store
										</a>
									)}
									{soon && (
										<span class="pill pill--soon">
											<i class="app__dot" />
											Coming soon
										</span>
									)}
									{t.site && (
										<a class="pill" href={t.site} rel="noopener">
											Find out more
											<svg class="pill__arrow" viewBox="0 0 24 24" aria-hidden="true">
												<path d="M8 16L16 8M9 8h7v7" />
											</svg>
										</a>
									)}
								</div>
								{t.site && <p class="story__site">{host(t.site)}</p>}
							</div>
						</div>
					</div>
				</dialog>
			);
		})
	}

	<dialog class="sheet sheet--compact sheet--contact" id="sheet-contact" data-sheet="contact" aria-labelledby="sheet-contact-title">
		<div class="sheet__scrim" data-scrim aria-hidden="true"></div>
		<div class="sheet__panel" data-panel>
			<span class="sheet__grabber" aria-hidden="true"></span>
			<button class="sheet__close" type="button" data-close aria-label="Close">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M6 6l12 12M18 6L6 18"></path>
				</svg>
			</button>
			<div class="sheet__body">
				<header class="sheet__head" data-reveal>
					<span class="app__icon sheet__icon" data-sheet-icon>
						<span class="app__at">@</span>
					</span>
					<div class="sheet__titles">
						<h2 class="sheet__title" id="sheet-contact-title">Contact</h2>
						<p class="sheet__kicker">{SITE.name}</p>
					</div>
				</header>
				<a class="contact__email" href={`mailto:${SITE.email}`} data-reveal>{SITE.email}</a>
				<div class="contact__links" data-reveal>
					{
						instagram && (
							<a href={instagram.url} rel="noopener" aria-label="Instagram" title="Instagram">
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<rect x="4" y="4" width="16" height="16" rx="5" />
									<circle cx="12" cy="12" r="3.5" />
									<circle class="fill" cx="17.2" cy="6.8" r="1.1" />
								</svg>
							</a>
						)
					}
					{
						youtube && (
							<a href={youtube.url} rel="noopener" aria-label="YouTube" title="YouTube">
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<rect x="3.5" y="6" width="17" height="12" rx="3.5" />
									<path class="fill" d="M10 9.2l5.2 2.8L10 14.8V9.2z" />
								</svg>
							</a>
						)
					}
					<a href={`mailto:${SITE.email}`} aria-label="Email" title="Email">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<rect x="3.5" y="6.5" width="17" height="11" rx="2.5" />
							<path d="M4.5 8l7.5 5.2L19.5 8" />
						</svg>
					</a>
				</div>
				<p class="contact__origin" data-reveal>
					With
					<svg class="contact__heart" viewBox="0 0 24 24" aria-label="love" role="img">
						<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
					</svg>
					from Romania
				</p>
				<p class="contact__legal" data-reveal>© {year} {SITE.legal}</p>
			</div>
		</div>
	</dialog>
</div>

{/* A file, not inline: the CSP allows 'self' and nothing inline. */}
<script is:inline src="/home.js" defer></script>

<style>
	/* ---- The screen ---------------------------------------------------------- */

	.home {
		position: relative;
		height: 100vh;
		height: 100dvh;
		min-height: 30rem;
		overflow: hidden;
		display: grid;
		grid-template-rows: 1fr auto;
		background: var(--ground);
		isolation: isolate;
	}
	.home::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			radial-gradient(140% 120% at 50% 40%, rgba(255, 255, 255, 0.025), transparent 48%),
			linear-gradient(to bottom, rgba(255, 255, 255, 0.015), transparent 32%);
		pointer-events: none;
	}
	.home__grain {
		position: absolute;
		inset: 0;
		z-index: -1;
		opacity: 0.14;
		background-image: radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.05) 1px, transparent 0);
		background-size: 3px 3px;
		mix-blend-mode: soft-light;
		pointer-events: none;
	}

	/* Where the clock would be. */
	.home__brand {
		display: flex;
		justify-content: center;
		align-items: flex-start;
		padding: max(env(safe-area-inset-top, 0px) + 40px, clamp(48px, 11vh, 120px)) 32px 0;
	}
	@media (max-width: 768px) {
		.home__brand {
			padding: max(env(safe-area-inset-top, 0px) + 28px, clamp(36px, 9vh, 88px)) 24px 0;
		}
	}

	/* ---- The dock ----------------------------------------------------------- */

	.dock {
		--icon: 58px;
		--gap: 12px;
		display: flex;
		justify-content: center;
		padding: 0 12px calc(env(safe-area-inset-bottom, 0px) + 18px);
		pointer-events: none;
	}
	@media (max-width: 768px) {
		.dock {
			--gap: clamp(6px, 2.4vw, 10px);
			/* As large as an iPhone's dock icons, and never wider than the screen
			   however many there are: screen less the dock's own padding and
			   gaps, shared out, less each item's breathing room. */
			--icon: min(60px, 14.5vw, calc((100vw - 52px - (var(--n) - 1) * var(--gap)) / var(--n) - 8px));
			padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 14px);
		}
	}
	.dock__tray {
		display: flex;
		align-items: flex-end;
		gap: var(--gap);
		margin: 0;
		padding: 10px 14px 12px;
		list-style: none;
		border: 1px solid var(--hairline);
		border-radius: 28px;
		background: rgba(10, 10, 10, 0.7);
		-webkit-backdrop-filter: blur(16px) saturate(140%);
		backdrop-filter: blur(16px) saturate(140%);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.04),
			0 18px 40px rgba(0, 0, 0, 0.45);
		pointer-events: auto;
	}
	.dock__item {
		--s: 1;
		display: flex;
		justify-content: center;
		width: calc(var(--icon) * var(--s) + 8px);
	}
	.dock__divider {
		display: none;
	}

	/* ---- An app icon ---------------------------------------------------------- */

	.app {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 7px;
		color: var(--ink);
		text-decoration: none;
		touch-action: manipulation;
		-webkit-tap-highlight-color: transparent;
		-webkit-touch-callout: none;
		user-select: none;
		-webkit-user-select: none;
	}
	.app:focus-visible {
		outline: none;
	}
	.app:focus-visible .app__icon {
		outline: 2px solid var(--ink);
		outline-offset: 3px;
	}

	.app__icon {
		--hx: 50%;
		--hy: 50%;
		position: relative;
		width: calc(var(--icon, 58px) * var(--s, 1));
		height: calc(var(--icon, 58px) * var(--s, 1));
		border: 1px solid #171717;
		border-radius: 22.37%;
		background:
			radial-gradient(90% 90% at var(--hx) var(--hy), rgba(255, 255, 255, 0.05), transparent 72%),
			linear-gradient(to bottom, #101010, #090909);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.05),
			inset 0 -1px 0 rgba(0, 0, 0, 0.8),
			0 10px 16px rgba(0, 0, 0, 0.45);
		display: grid;
		place-items: center;
		color: #fbfbfb;
		transition:
			border-color 180ms var(--ease),
			filter 180ms var(--ease),
			scale 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	.app:hover .app__icon {
		border-color: #252525;
		filter: brightness(1.06);
	}
	/* The press, as a finger feels it. */
	.app:active .app__icon {
		scale: 0.9;
		filter: brightness(0.85);
		transition-duration: 90ms;
	}

	.app__glyph,
	.app__svg {
		width: 52%;
		height: 52%;
	}
	.app__initial {
		font-family: var(--font-voice);
		font-optical-sizing: auto;
		font-style: italic;
		font-size: calc(var(--icon, 58px) * var(--s, 1) * 0.5);
		line-height: 1;
		color: var(--ink);
		translate: 0 -0.04em;
	}
	.app__at {
		font-family: var(--font-ui);
		font-size: calc(var(--icon, 58px) * var(--s, 1) * 0.5);
		font-weight: 400;
		line-height: 1;
		translate: 0 -0.05em;
	}

	/* Not here yet: a small dot before the name, as iOS marks a new app.
	   Nothing dimmed, nothing that blinks. */
	.app__dot {
		display: inline-block;
		width: 5px;
		height: 5px;
		margin-inline-end: 4px;
		border-radius: 50%;
		background: var(--ink-2);
		vertical-align: 0.12em;
	}

	.app__label {
		font-size: 11px;
		line-height: 1;
		letter-spacing: 0.01em;
		color: var(--ink-2);
		white-space: nowrap;
	}

	/* ---- A Mac: labels as tooltips, a divider, magnification ------------------ */

	@media (hover: hover) and (pointer: fine) {
		.dock__tray {
			height: calc(var(--icon) + 24px);
			padding: 10px 12px;
			align-items: flex-end;
		}
		.dock__divider {
			display: block;
			align-self: center;
			width: 1px;
			height: calc(var(--icon) * 0.78);
			margin-inline: 2px;
			background: var(--hairline-strong);
		}
		.app__label {
			position: absolute;
			bottom: calc(100% + 12px);
			left: 50%;
			translate: -50% 4px;
			padding: 5px 10px 6px;
			border: 1px solid var(--hairline-strong);
			border-radius: 8px;
			background: rgba(22, 22, 22, 0.92);
			-webkit-backdrop-filter: blur(10px);
			backdrop-filter: blur(10px);
			font-size: 12px;
			color: var(--ink);
			opacity: 0;
			pointer-events: none;
			transition:
				opacity 160ms var(--ease),
				translate 220ms var(--ease);
		}
		.app:hover .app__label,
		.app:focus-visible .app__label {
			opacity: 1;
			translate: -50% 0;
		}
		.app--soon .app__label::after {
			content: ' · coming soon';
			color: var(--ink-2);
		}
		.app__label .app__dot {
			display: none;
		}
	}

	/* ---- The sheet -------------------------------------------------------------- */

	.sheet {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 24px;
		border: 0;
		background: transparent;
		color: var(--ink);
		overflow: hidden;
		overscroll-behavior: contain;
	}
	.sheet[open] {
		display: grid;
		place-items: center;
	}
	.sheet::backdrop {
		background: transparent;
	}
	.sheet__scrim {
		position: absolute;
		inset: 0;
		background: rgba(3, 3, 3, 0.78);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
	}

	.sheet__panel {
		position: relative;
		display: grid;
		width: min(480px, 100%);
		max-height: calc(100dvh - 72px);
		border: 1px solid var(--hairline);
		border-radius: 24px;
		background: #090909;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.04),
			0 30px 80px rgba(0, 0, 0, 0.6);
		overflow: hidden;
	}
	.sheet__panel:focus {
		outline: none;
	}
	.sheet__grabber {
		display: none;
	}
	.sheet__close {
		position: absolute;
		top: 14px;
		right: 14px;
		z-index: 2;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		display: grid;
		place-items: center;
		color: rgba(255, 255, 255, 0.85);
		background: rgba(0, 0, 0, 0.42);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
		transition:
			background-color 160ms var(--ease),
			color 160ms var(--ease);
	}
	.sheet__close:hover {
		color: #fff;
		background: rgba(0, 0, 0, 0.6);
	}
	.sheet__close svg {
		width: 16px;
		height: 16px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
	}

	.sheet__body {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 20px;
		padding: 40px 36px;
		min-width: 0;
	}
	.sheet__head {
		display: flex;
		align-items: center;
		gap: 16px;
	}
	.sheet__icon {
		--icon: 64px;
		flex: 0 0 auto;
		transform-origin: 0 0;
		will-change: transform;
	}
	.sheet__titles {
		display: grid;
		gap: 5px;
		min-width: 0;
	}
	.sheet__title {
		font-family: var(--font-voice);
		font-optical-sizing: auto;
		font-weight: 400;
		font-size: 1.6rem;
		line-height: 1.05;
		letter-spacing: -0.01em;
	}
	.sheet__kicker {
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-2);
	}
	.sheet__desc {
		max-width: 38ch;
		font-size: 0.95rem;
		line-height: 1.6;
