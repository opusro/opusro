---
/**
 * The holding page: what opus.ro shows while the writing is being done.
 *
 * The mark and what the name means, the one tool you can actually get today,
 * and how to reach us. No story, no notes, no product pages, no claims. In
 * this mode nothing else is built either, so there is nothing else to find.
 */
import BrandMark from './BrandMark.astro';
import { SITE, DOORWAYS } from '../config';
import { allTools } from '../lib/notes';

const loop = (await allTools()).find((tool) => tool.id === 'loop');
---

<div class="holding">
	<div class="holding__grain" aria-hidden="true"></div>

	<div class="holding__inner">
		<BrandMark />

		{
			loop?.data.appStoreUrl && (
				<a class="card card--loop" href={loop.data.appStoreUrl} data-tilt>
					<span class="tile" aria-hidden="true">
						{loop.data.glyph ? (
							<img src={loop.data.glyph} alt="" width="30" height="30" />
						) : (
							<span class="tile__initial">l</span>
						)}
					</span>
					<span class="card__text">
						<span class="card__name">{loop.data.name}</span>
						<span class="card__line">on the App Store</span>
					</span>
				</a>
			)
		}

		<address class="card card--contact">
			<a class="card__email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
			<span class="card__links">
				{DOORWAYS.map((d) => <a href={d.url}>{d.label}</a>)}
			</span>
		</address>

		<p class="holding__legal">{SITE.legal} · {SITE.city}</p>
	</div>
</div>

{/* A file, not inline: the CSP allows 'self' and nothing inline. */}
<script is:inline src="/brand.js" defer></script>
<script is:inline src="/home.js" defer></script>

<style>
	.holding {
		position: relative;
		min-height: 100svh;
		display: grid;
		place-items: center;
		padding: var(--space-2xl) var(--gutter);
		overflow: hidden;
		background:
			radial-gradient(140% 120% at 50% 30%, rgba(255, 255, 255, 0.025), transparent 48%),
			linear-gradient(to bottom, rgba(255, 255, 255, 0.015), transparent 32%);
	}
	.holding__grain {
		position: absolute;
		inset: 0;
		opacity: 0.14;
		background-image: radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.05) 1px, transparent 0);
		background-size: 3px 3px;
		mix-blend-mode: soft-light;
		pointer-events: none;
	}
	.holding__inner {
		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
		gap: var(--space-l);
		width: min(22rem, 100%);
	}

	/* No panel: the icon and the words sit on the page itself. */
	.card {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		padding: 0.35rem 0;
		text-decoration: none;
		color: var(--ink);
		font-style: normal;
		transition: transform var(--duration) var(--ease);
		width: 100%;
	}
	.card--loop:active {
		transform: scale(0.985);
	}
	.card--loop:hover .card__name {
		text-decoration: underline;
		text-decoration-color: var(--hairline-strong);
		text-underline-offset: 0.18em;
	}
	.card .tile {
		width: 46px;
		height: 46px;
		flex-basis: 46px;
	}
	.card .tile img {
		width: 26px;
		height: 26px;
	}
	.card__text {
		display: grid;
		gap: 0.1rem;
	}
	.card__name {
		font-family: var(--font-voice);
		font-optical-sizing: auto;
		font-size: var(--step-1);
		line-height: 1.1;
	}
	.card__line {
		font-size: var(--step--1);
		color: var(--ink-2);
	}

	.card--contact {
		justify-content: space-between;
		gap: var(--space-s);
		flex-wrap: wrap;
	}
	.card__email {
		font-size: var(--step--1);
		color: var(--ink);
		text-decoration-color: var(--hairline-strong);
	}
	.card__email:hover {
		text-decoration-color: var(--ink);
	}
	.card__links {
		display: flex;
		gap: var(--space-s);
	}
	.card__links a {
		font-family: var(--font-mono);
		font-size: var(--step--2);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-3);
		text-decoration: none;
	}
	.card__links a:hover {
		color: var(--ink);
	}

	.holding__legal {
		font-family: var(--font-mono);
		font-size: var(--step--2);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-3);
	}
</style>
